# ==============================================================================
# DarGlobal AI Knowledge Assistant - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security & Network Controls
# Comma-separated list or JSON array of allowed origins for CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
# Maximum allowed HTTP request body size in bytes (default: 64 KB)
MAX_REQUEST_SIZE_BYTES=65536
# Rate limiting: max requests per minute per client IP
RATE_LIMIT_PER_MINUTE=60

# OpenRouter LLM Configuration
# Obtain your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Required primary locked model
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Controlled Multi-Model Fallback:
# OPENROUTER_ALLOW_FALLBACK=false (default, model locked strictly to primary)
# Set to true to enable routing to Priority 2 (Fallback 1) and Priority 3 (Fallback 2) on eligible transient errors.
OPENROUTER_ALLOW_FALLBACK=true
# Fallback models: Priority 2 (Fallback 1) and Priority 3 (Fallback 2), separated by semicolon (;) or comma (,)
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free;google/gemma-4-26b-a4b-it:free
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30.0

# Vector Database & Embeddings
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=darglobal_wasalt_knowledge
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
# Configurable similarity threshold (0.0 to 1.0; cosine similarity cutoff)
SIMILARITY_THRESHOLD=0.45

# Provenance & Demonstration Safeguards
# Keep false by default (strict verified mode). Set to true only when demonstrating current sample unverified data.
ALLOW_UNVERIFIED_DEMO_DATA=false

# Source Ingestion Toggles (Configure permitted access per source)
ENABLE_DARGLOBAL_INGESTION=true
ENABLE_WASALT_INGESTION=true
INGESTION_DATA_DIR=./data

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
